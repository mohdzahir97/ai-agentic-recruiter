# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="AI Recruitment MVP"
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# The Next.js dev server. Add any other browser origin that calls this API.
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL is the intended database. `docker compose up -d postgres` starts
# one matching this URL.
DATABASE_URL=postgresql+psycopg://recruit:recruit@localhost:5432/recruitment

# No Postgres to hand? SQLite needs nothing installed and the app is identical:
# DATABASE_URL=sqlite:///./data/app.db

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
# groq | openai | gemini | ollama | fallback
#
# "fallback" runs the deterministic rule-based agents: no API key, no network,
# and the whole application still works end to end. That is also what happens
# automatically if the configured provider has no key or a call fails.
LLM_PROVIDER=groq

# Model for the chosen provider. Suggested defaults:
#   groq    openai/gpt-oss-120b
#   openai  gpt-4o-mini
#   gemini  gemini-2.0-flash
#   ollama  llama3.1
LLM_MODEL=openai/gpt-oss-120b

LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60

# Only the key for the provider you selected needs a value.
GROQ_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# RAG
# ---------------------------------------------------------------------------
# "local" uses the MiniLM model bundled with ChromaDB — no API key, no network
# call. Switch to openai/gemini/ollama to compare retrieval quality.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small

CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=4

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
UPLOAD_DIR=./data/uploads
CHROMA_PERSIST_DIR=./data/chroma
MAX_UPLOAD_SIZE_MB=10

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
